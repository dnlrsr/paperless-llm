# ─── Paperless-ngx ───────────────────────────────────────────────────────────
# Base URL of your paperless-ngx instance (inside Docker network)
PAPERLESS_BASE_URL=http://paperless-ngx:8000
# Generate via: paperless-ngx createsuperuser → Settings → API Tokens
PAPERLESS_API_TOKEN=your-paperless-api-token-here

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Options: ollama | openai | anthropic | mistral
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# Required for ollama (default: http://localhost:11434/api)
OLLAMA_HOST=http://ollama:11434/api
# Timeout for a single Ollama HTTP request in seconds (default: 600).
# Large models (e.g. qwen3:14b, 8+ GiB) can take several minutes to cold-load
# from disk into GPU memory. Set to 0 to wait forever.
# OLLAMA_REQUEST_TIMEOUT_SECONDS=600
# Required for OpenAI / Anthropic / Mistral
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
LOG_LEVEL=info
REDIS_URL=redis://redis:6379
DATABASE_URL=file:./data/paperless-llm.db

# ─── Processing tags ─────────────────────────────────────────────────────────
# Tag to apply to documents queued for manual review
MANUAL_TAG=paperless-llm
# Automatically generate suggestions as soon as MANUAL_TAG is detected.
# Set to false to trigger generation manually from the UI instead.
MANUAL_AUTO_GENERATE=true
# Tag to apply to documents queued for auto-processing
AUTO_TAG=paperless-llm-auto
# Tag applied after suggestions are applied
PROCESSED_TAG=paperless-llm-processed

# ─── Pipeline ────────────────────────────────────────────────────────────────
AUTO_GENERATE_TITLE=true
AUTO_GENERATE_TAGS=true
AUTO_GENERATE_CORRESPONDENTS=true
AUTO_GENERATE_DOCUMENT_TYPE=true
AUTO_GENERATE_CREATED_DATE=true
AUTO_GENERATE_CUSTOM_FIELDS=false

# ─── OCR (off by default — enable per-document via the UI stage picker) ──────
OCR_PROVIDER=llm
OCR_PROCESS_MODE=image
PDF_SKIP_EXISTING_OCR=true

# ─── Auth ────────────────────────────────────────────────────────────────────
# Set to "false" to disable authentication (not recommended for production)
AUTH_ENABLED=true
# Required when AUTH_ENABLED=true — must be at least 32 characters
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
