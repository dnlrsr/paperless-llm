# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ─── Paperless-ngx ───────────────────────────────────────────────────────────
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=your-paperless-api-token

# Tag that marks documents waiting to be processed
PAPERLESS_PROCESS_TAG=paperless-llm

# Tag applied once a document has been processed successfully
PAPERLESS_DONE_TAG=paperless-llm-done

# How often (seconds) to poll for tagged documents
POLLING_INTERVAL_SECONDS=60

# ─── Database ────────────────────────────────────────────────────────────────
DB_PATH=./data/db.sqlite

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Supported: openai | anthropic | mistral | google | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=...

# Mistral
# MISTRAL_API_KEY=...

# Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2-vision

# ─── OCR ─────────────────────────────────────────────────────────────────────
# Supported: none | llm-vision | azure-document-intelligence | docling
OCR_MODE=none

# Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://....cognitiveservices.azure.com/
# AZURE_DOCUMENT_INTELLIGENCE_KEY=...

# Docling (self-hosted)
# DOCLING_URL=http://localhost:5000

# ─── Prompts ─────────────────────────────────────────────────────────────────
PROMPTS_DIR=./prompts
DEFAULT_PROMPTS_DIR=./default_prompts

# ─── Pipeline stages (all enabled by default) ────────────────────────────────
ENABLE_TITLE=true
ENABLE_TAGS=true
ENABLE_CORRESPONDENT=true
ENABLE_DOCUMENT_TYPE=true
ENABLE_CREATED_DATE=true
ENABLE_SUMMARY=false

# Blacklist correspondents by name (comma-separated) to prevent suggestion
# CORRESPONDENT_BLACKLIST=Unknown,Test

# ─── i18n ────────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en
