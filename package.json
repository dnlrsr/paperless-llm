{
    "name": "paperless-llm",
    "private": true,
    "version": "0.1.0",
    "packageManager": "pnpm@9.15.0",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "test": "turbo test",
        "typecheck": "turbo typecheck",
        "clean": "turbo clean && rm -rf node_modules"
    },
    "devDependencies": {
        "turbo": "^2.3.3",
        "typescript": "^5.7.3",
        "@types/node": "^22.10.7",
        "prettier": "^3.4.2",
        "eslint": "^9.18.0",
        "@typescript-eslint/eslint-plugin": "^8.20.0",
        "@typescript-eslint/parser": "^8.20.0"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "pnpm": {
        "overrides": {
            "ioredis": "^5.10.0"
        },
        "ignoredOptionalDependencies": [
            "@napi-rs/canvas"
        ]
    }
}